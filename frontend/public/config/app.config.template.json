{
  "apiUrl": "/api",
  "websocketUrl": "/ws",

  "cognito": {
    "authority": "https://cognito-idp.<region>.amazonaws.com/<user-pool-id>",
    "redirectUrl": "<app-base-url>/callback",
    "clientId": "<client-id>",
    "scope": "openid email profile",
    "responseType": "code",
    "customParamsEndSessionRequest": {
      "client_id": "<client-id>",
      "logout_uri": "<app-base-url>"
    }
  }
}

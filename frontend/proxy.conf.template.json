{
  "/api": {
    "target": "https://<aws_api_base_url>",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api": ""
    },
    "logLevel": "debug"
  },
  "/ws": {
    "target": "https://<aws_websocket_api_domain>",
    "ws": true,
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/ws": "/$default"
    },
    "logLevel": "debug"
  }
}
